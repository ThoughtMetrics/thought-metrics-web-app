---
import InteractionFooter from '@/shared/components/interaction-footer';
import LandingHeader from '@/shared/components/landing-header';
import Layout from '@layouts/Layout.astro';
import type { ImageMetadata } from 'astro';

export interface Props {
  title: string;
  description: string;
  keywords?: string;
  ogImage?: ImageMetadata | string;
  ogType?: string;
  canonical?: string;
  noindex?: boolean;
  nofollow?: boolean;
}

const {
  title,
  description,
  keywords,
  ogImage,
  ogType,
  canonical,
  noindex,
  nofollow,
} = Astro.props;
---

<Layout
  title={title}
  description={description}
  keywords={keywords}
  ogImage={ogImage}
  ogType={ogType}
  canonical={canonical}
  noindex={noindex}
  nofollow={nofollow}
>
  <div
    class="w-full min-h-screen flex flex-col justify-between bg-background overflow-y-scroll overflow-x-hidden"
  >
    <LandingHeader client:only="react" />
    <div class="flex-1">
      <slot />
    </div>
    <InteractionFooter client:load />
  </div>
</Layout>
