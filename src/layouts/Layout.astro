---
import RuntimeConfig from '@components/RuntimeConfig.astro';
import '@styles/global.css';
import '@styles/animations.css';
import '@styles/variables.css';
import { ClientRouter } from 'astro:transitions';
import AppWrapper from '@/shared/components/AppWrapper';

export interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  ogImage?: string;
}

const {
  title = 'Thought Metrics',
  description = 'Thought Metrics Website',
  keywords,
  ogImage,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <!-- CRITICAL: RuntimeConfig must be first to prevent hydration errors -->
    <RuntimeConfig />

    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/icons/thought-metrics.svg" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />

    <!-- Enable ClientRouter for SPA-like navigation -->
    <ClientRouter />

    <!-- Scroll handling script -->
    <!-- <script>
      // Handle scroll restoration and hash navigation
      document.addEventListener('astro:after-swap', () => {
        // Check for hash in URL
        if (window.location.hash) {
          const targetElement = document.querySelector(window.location.hash);
          if (targetElement) {
            setTimeout(() => {
              targetElement.scrollIntoView({
                behavior: 'smooth',
                block: 'start',
              });
            }, 100);
          }
        } else {
          // Scroll to top on page navigation
          window.scrollTo({ top: 0, left: 0, behavior: 'instant' });
        }
      });

      // Handle initial page load with hash
      document.addEventListener('DOMContentLoaded', () => {
        if (window.location.hash) {
          const targetElement = document.querySelector(window.location.hash);
          if (targetElement) {
            setTimeout(() => {
              targetElement.scrollIntoView({
                behavior: 'smooth',
                block: 'start',
              });
            }, 100);
          }
        }
      });

      // Handle page load complete
      document.addEventListener('astro:page-load', () => {
        // Additional scroll handling if needed after full page load
        console.log('Page fully loaded');
      });
    </script> -->

    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/swiper@12/swiper-bundle.min.css"
    />

    <script src="https://cdn.jsdelivr.net/npm/swiper@12/swiper-bundle.min.js"
    ></script>

    <!-- Status bar styling for iOS -->
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta
      name="apple-mobile-web-app-status-bar-style"
      content="black-translucent"
    />

    <!-- Theme color for browser UI -->
    <meta name="theme-color" content="#000000" />

    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- Allow additional head content from pages -->
    <slot name="head" />
  </head>
  <body id="root">
    <AppWrapper client:only="react">
      <slot />
    </AppWrapper>
  </body>
</html>
