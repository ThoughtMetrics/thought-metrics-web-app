---
import { ClientRouter } from 'astro:transitions';
import RuntimeConfig from '@components/RuntimeConfig.astro';
import SEOHead from '@/shared/components/SEOHead.astro';
import '@styles/global.css';
import '@styles/animations.css';
import '@styles/variables.css';
import '@styles/markdown.css';
import AppWrapper from '@/shared/components/AppWrapper';
import faviconSvg from '@assets/icons/thought-metrics.svg';
import Cookiebot from '@/shared/components/analytics/Cookiebot.astro';
import GoogleTagManager from '@/shared/components/analytics/GoogleTagManager.astro';

export interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  ogImage?: string;
  ogType?: string;
  canonical?: string;
  noindex?: boolean;
  nofollow?: boolean;
}

const {
  title = 'Thought Metrics',
  description = 'Thought Metrics Website',
  keywords,
  ogImage,
  ogType,
  canonical,
  noindex,
  nofollow,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <!-- CRITICAL: RuntimeConfig must be first to prevent hydration errors -->
    <RuntimeConfig />

    <!-- CRITICAL: Cookiebot must load BEFORE any tracking scripts to manage consent -->
    <!-- <Cookiebot /> -->

    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={faviconSvg.src} />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />

    <meta
      name="google-site-verification"
      content="-yZOthuzoNTG-TuxrdHd4TPsKgbJobv0khZRx_Vnslk"
    />

    <!-- Swiper styles (loaded early for above-the-fold content) -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/swiper@12/swiper-bundle.min.css"
    />

    <!-- Swiper script (deferred for better performance) -->
    <script
      src="https://cdn.jsdelivr.net/npm/swiper@12/swiper-bundle.min.js"
      defer></script>

    <!-- Status bar styling for iOS -->
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta
      name="apple-mobile-web-app-status-bar-style"
      content="black-translucent"
    />

    <!-- Theme color for browser UI -->
    <meta name="theme-color" content="#ffffff" />

    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags (Following PRO India SEO Guidelines) -->
    <SEOHead
      title={title}
      description={description}
      keywords={keywords}
      ogImage={ogImage}
      ogType={ogType}
      canonical={canonical}
      noindex={noindex}
      nofollow={nofollow}
    />

    <!-- Analytics & Tracking (GTM manages: GA4, Clarity) -->
    <!-- Note: Cookiebot loads BEFORE GTM to control consent -->
    <GoogleTagManager />

    <!-- View Transitions for smooth page navigation -->
    <ClientRouter />

    <!-- Allow additional head content from pages -->
    <slot name="head" />

    <!-- View Transition Fade Animation Styles -->
    <style is:global>
      /* Smooth fade transition for page navigation (0.5s duration) */
      ::view-transition-old(root) {
        animation: 0.5s ease-out both fade-out;
      }

      ::view-transition-new(root) {
        animation: 0.5s ease-in both fade-in;
      }

      /* Fade animations */
      @keyframes fade-out {
        from { opacity: 1; }
        to { opacity: 0; }
      }

      @keyframes fade-in {
        from { opacity: 0; }
        to { opacity: 1; }
      }

      /* Accessibility: Reduce motion for users who prefer it */
      @media (prefers-reduced-motion: reduce) {
        ::view-transition-old(root),
        ::view-transition-new(root) {
          animation-duration: 0.01s;
        }
      }
    </style>
  </head>
  <body id="root">
    <!-- Google Tag Manager (noscript fallback) -->
    <noscript>
      <iframe
        src={`https://www.googletagmanager.com/ns.html?id=${import.meta.env.PUBLIC_GTM_ID}`}
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe>
    </noscript>

    <AppWrapper client:only="react">
      <slot />
    </AppWrapper>
  </body>
</html>
