---
import { ClientRouter } from 'astro:transitions';
import RuntimeConfig from '@components/RuntimeConfig.astro';
import SEOHead from '@/shared/components/SEOHead.astro';
import '@styles/global.css';
import '@styles/animations.css';
import '@styles/variables.css';
import '@styles/design-system.css';
import '@styles/markdown.css';
import AppWrapper from '@/shared/components/AppWrapper';
import PageLoader from '@/shared/components/PageLoader';
import GoogleTagManager from '@/shared/components/analytics/GoogleTagManager.astro';
import ConsentMode from '@/shared/components/analytics/ConsentMode.astro';
import CookieConsentBanner from '@/shared/components/CookieConsentBanner';
import { getAPIConfig } from '@/core/configs/api-config';
import type { ImageMetadata } from 'astro';

export interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  ogImage?: ImageMetadata | string;
  ogType?: string;
  canonical?: string;
  noindex?: boolean;
  nofollow?: boolean;
  structuredData?: object;
}

const {
  title = 'Thought Metrics',
  description = 'Thought Metrics Website',
  keywords,
  ogImage,
  ogType,
  canonical,
  noindex,
  nofollow,
  structuredData,
} = Astro.props;

const config = getAPIConfig();
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <!-- Apply saved theme before paint and after every View Transition swap -->
    <script is:inline>
      (function() {
        function applyTheme() {
          var saved = localStorage.getItem('tm-theme');
          if (saved === 'light' || saved === 'dark') {
            document.documentElement.setAttribute('data-theme', saved);
          }
        }
        applyTheme();
        document.addEventListener('astro:after-swap', applyTheme);
      })();
    </script>

    <!-- CRITICAL: RuntimeConfig must be first to prevent hydration errors -->
    <RuntimeConfig />

    <!-- CRITICAL: Google Consent Mode v2 must load BEFORE GTM -->
    <ConsentMode />

    <!-- Analytics & Tracking (GTM manages: GA4, Clarity) -->
    <GoogleTagManager gtmId={config.gtmId} />

    <meta charset="utf-8" />

    <!-- Favicons (Static files for SEO - no hashing) -->
    <!-- ICO for legacy browsers and SERP fallback -->
    <link rel="icon" href="/favicon.ico" />
    <!-- PNG for Google SERP (preferred format) -->
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <!-- SVG for modern browsers -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Apple touch icon for iOS/Safari -->
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />

    <meta
      name="google-site-verification"
      content="-yZOthuzoNTG-TuxrdHd4TPsKgbJobv0khZRx_Vnslk"
    />

    <!-- Typography: Plus Jakarta Sans + Material Symbols -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400;1,600&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap"
      rel="stylesheet"
    />

    <!-- Swiper styles (loaded early for above-the-fold content) -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/swiper@12/swiper-bundle.min.css"
    />

    <!-- Swiper script (deferred for better performance) -->
    <script
      is:inline
      src="https://cdn.jsdelivr.net/npm/swiper@12/swiper-bundle.min.js"
      defer></script>

    <!-- Status bar styling for iOS -->
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta
      name="apple-mobile-web-app-status-bar-style"
      content="black-translucent"
    />

    <!-- Theme color for browser UI -->
    <meta name="theme-color" content="#131313" />

    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags (Following PRO India SEO Guidelines) -->
    <SEOHead
      title={title}
      description={description}
      keywords={keywords}
      ogImage={ogImage}
      ogType={ogType}
      canonical={canonical}
      noindex={noindex}
      nofollow={nofollow}
      structuredData={structuredData}
    />

    <!-- View Transitions for smooth page navigation -->
    <ClientRouter />

    <!-- Allow additional head content from pages -->
    <slot name="head" />

    <!-- View Transition Fade Animation Styles -->
    <style is:global>
      /* Smooth fade transition for page navigation (0.5s duration) */
      ::view-transition-old(root) {
        animation: 0.5s ease-out both fade-out;
      }

      ::view-transition-new(root) {
        animation: 0.5s ease-in both fade-in;
      }

      /* Fade animations */
      @keyframes fade-out {
        from {
          opacity: 1;
        }
        to {
          opacity: 0;
        }
      }

      @keyframes fade-in {
        from {
          opacity: 0;
        }
        to {
          opacity: 1;
        }
      }

      /* Accessibility: Reduce motion for users who prefer it */
      @media (prefers-reduced-motion: reduce) {
        ::view-transition-old(root),
        ::view-transition-new(root) {
          animation-duration: 0.01s;
        }
      }
    </style>
  </head>
  <body id="root">
    <!-- Google Tag Manager (noscript) -->
    <noscript
      ><iframe
        src={`https://www.googletagmanager.com/ns.html?id=${config.gtmId}`}
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe></noscript
    >
    <!-- End Google Tag Manager (noscript) -->
    <!-- Full-screen loader for page navigation -->
    <PageLoader client:load />

    <!-- Header island lives here as a direct body child, separate from AppWrapper -->
    <slot name="header" />

    <AppWrapper client:only="react">
      <slot />
    </AppWrapper>

    <!-- Cookie Consent Banner -->
    <CookieConsentBanner client:load />

  </body>
</html>
