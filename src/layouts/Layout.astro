---
import RuntimeConfig from "@components/RuntimeConfig.astro";
import "@styles/index.css";
import "@styles/animations.css";
import "@styles/variables.css";

export interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  ogImage?: string;
}

const {
  title = "Thought Metrics",
  description = "Thought Metrics Website",
  keywords,
  ogImage,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <!-- CRITICAL: RuntimeConfig must be first to prevent hydration errors -->
    <RuntimeConfig />

    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/icons/thought-metrics.svg" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />

    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"
    />
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"
    ></script>

    <!-- Status bar styling for iOS -->
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta
      name="apple-mobile-web-app-status-bar-style"
      content="black-translucent"
    />

    <!-- Theme color for browser UI -->
    <meta name="theme-color" content="#000000" />

    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- Allow additional head content from pages -->
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
