---
import FooterWrapper from '@components/footer';
import HeaderWrapper from '@components/header';
import Layout from '@layouts/Layout.astro';
import type { ImageMetadata } from 'astro';

export interface Props {
  title: string;
  description: string;
  keywords?: string;
  ogImage?: ImageMetadata | string;
  ogType?: string;
  canonical?: string;
  noindex?: boolean;
  nofollow?: boolean;
}

const {
  title,
  description,
  keywords,
  ogImage,
  ogType,
  canonical,
  noindex,
  nofollow,
} = Astro.props;
---

<Layout
  title={title}
  description={description}
  keywords={keywords}
  ogImage={ogImage}
  ogType={ogType}
  canonical={canonical}
  noindex={noindex}
  nofollow={nofollow}
>
  <HeaderWrapper client:load />
  <slot />
  <FooterWrapper client:load />
</Layout>
