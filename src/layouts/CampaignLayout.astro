---
import Layout from '@layouts/Layout.astro';
import CampaignHeader from '@/shared/components/campaign-header/index';
import type { ImageMetadata } from 'astro';

export interface Props {
  title: string;
  description: string;
  keywords?: string;
  ogImage?: ImageMetadata | string;
  canonical?: string;
  noindex?: boolean;
  nofollow?: boolean;
}

const {
  title,
  description,
  keywords,
  ogImage,
  canonical,
  noindex,
  nofollow,
} = Astro.props;
---

<Layout
  title={title}
  description={description}
  keywords={keywords}
  ogImage={ogImage}
  canonical={canonical}
  noindex={noindex}
  nofollow={nofollow}
>
  <div class="w-full min-h-screen flex flex-col">
    <!-- Logo-only header — no navigation -->
    <CampaignHeader client:load />

    <!-- Page content -->
    <div class="flex-1 w-full overflow-y-auto">
      <slot />
    </div>

    <!-- Gradient border footer — primary to secondary, no links -->
    <!-- pb-safe ensures gradient clears iOS home indicator / Android gesture nav -->
    <div class="w-full bg-linear-to-r from-secondary to-primary shrink-0" style="height: calc(1rem + env(safe-area-inset-bottom, 0px));"></div>
  </div>
</Layout>
