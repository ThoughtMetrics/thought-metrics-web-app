---
import Layout from '@layouts/Layout.astro';
import type { ImageMetadata } from 'astro';

export interface Props {
  title: string;
  description: string;
  keywords?: string;
  ogImage?: ImageMetadata | string;
  canonical?: string;
  noindex?: boolean;
  nofollow?: boolean;
}

const {
  title,
  description,
  keywords,
  ogImage,
  canonical,
  noindex,
  nofollow,
} = Astro.props;
---

<Layout
  title={title}
  description={description}
  keywords={keywords}
  ogImage={ogImage}
  canonical={canonical}
  noindex={noindex}
  nofollow={nofollow}
>
  <div class="w-full min-h-screen flex flex-col">
    <div class="flex-1 w-full overflow-y-auto">
      <slot />
    </div>
    <!-- Gradient border footer — primary & secondary brand colours -->
    <div class="w-full h-1 md:h-1.5 bg-linear-to-r from-secondary to-primary shrink-0"></div>
  </div>
</Layout>
