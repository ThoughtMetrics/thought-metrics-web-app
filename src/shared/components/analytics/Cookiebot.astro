---
const { cookiebotId } = Astro.props;
---

<!--
  Cookiebot Consent Management Platform (CMP)

  PURPOSE: Cookie consent banner and GDPR/CCPA compliance

  CRITICAL: Must load BEFORE Google Tag Manager and any tracking scripts!

  HOW IT WORKS:
  1. Loads Cookiebot consent banner script
  2. User grants/denies consent for cookie categories
  3. Cookiebot blocks/allows scripts based on consent
  4. GTM tags respect consent settings via Consent Mode v2

  SETUP:
  1. Get Cookiebot ID from https://manage.cookiebot.com (format: xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx)
  2. Add PUBLIC_COOKIEBOT_ID to .env and ensure it's in window.__APP_CONFIG__
  3. Configure cookie categories in Cookiebot dashboard
  4. Add consent settings to GTM tags (GA4, Clarity, etc.)

  BLOCKING MODE:
  - 'auto': Cookiebot automatically scans and blocks tracking scripts
  - Recommended for GDPR compliance
-->

{cookiebotId && cookiebotId.length > 0 && (
  <script
    is:inline
    set:html={`
      (function() {
        // Initialize Cookiebot (Official Cookiebot snippet)
        var script = document.createElement('script');
        script.id = 'Cookiebot';
        script.src = 'https://consent.cookiebot.com/uc.js';
        script.setAttribute('data-cbid', '${cookiebotId}');
        script.setAttribute('data-blockingmode', 'auto');
        script.type = 'text/javascript';

        // Insert as first script to load before tracking scripts
        var firstScript = document.getElementsByTagName('script')[0];
        if (firstScript && firstScript.parentNode) {
          firstScript.parentNode.insertBefore(script, firstScript);
        } else {
          document.head.appendChild(script);
        }
      })();
    `}
  />
)}
