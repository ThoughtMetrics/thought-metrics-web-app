---
/**
 * Cookiebot Component
 *
 * PURPOSE: GDPR/CCPA Cookie Consent Management
 *
 * WHAT COOKIEBOT DOES:
 * - Shows cookie consent banner to users
 * - Blocks non-essential cookies until user consents
 * - Automatically scans your site for cookies
 * - Generates privacy policy and cookie declaration
 * - Manages user consent across sessions
 *
 * HOW IT WORKS:
 * 1. Cookiebot script loads first (blocks other scripts)
 * 2. Scans page for cookies and categorizes them:
 *    - Necessary (always allowed)
 *    - Preferences (optional)
 *    - Statistics (optional - GA4, Clarity)
 *    - Marketing (optional - Pinterest, ads)
 * 3. User selects preferences via consent banner
 * 4. Only approved categories load
 * 5. Consent stored in cookie (12 months)
 *
 * SETUP:
 * 1. Sign up at https://www.cookiebot.com
 * 2. Add your domain
 * 3. Get Domain Group ID (cbid)
 * 4. Add PUBLIC_COOKIEBOT_ID to .env
 * 5. Scan your site in Cookiebot dashboard
 *
 * INTEGRATIONS:
 * - Works automatically with GTM (add data-cookieconsent attribute)
 * - Blocks GA4, Clarity until consent
 * - Updates consent in dataLayer for GTM
 *
 * BEST PRACTICES:
 * - Place before any other tracking scripts
 * - Use 'statistics' category for analytics (GA4, Clarity)
 * - Use 'marketing' category for ads (Pinterest)
 * - Test in incognito to see consent flow
 *
 * LEGAL COMPLIANCE:
 * - GDPR (EU)
 * - CCPA (California)
 * - ePrivacy Directive
 * - LGPD (Brazil)
 */

---

<script>
  import { getAPIConfig } from '@configs/api-config';

  const config = getAPIConfig();
  const cookiebotId = config.publicCookiebotId;

  if (cookiebotId && cookiebotId.length > 0) {
    // Dynamically inject Cookiebot script
    const script = document.createElement('script');
    script.id = 'Cookiebot';
    script.src = 'https://consent.cookiebot.com/uc.js';
    script.setAttribute('data-cbid', cookiebotId);
    script.setAttribute('data-blockingmode', 'auto');
    script.type = 'text/javascript';
    document.head.appendChild(script);
  }
</script>
