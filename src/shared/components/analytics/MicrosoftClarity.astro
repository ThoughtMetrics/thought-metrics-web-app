---
/**
 * Microsoft Clarity Component
 *
 * PURPOSE: FREE session recordings, heatmaps, and user behavior analytics
 *
 * WHAT CLARITY PROVIDES:
 * - Session Recordings: Watch exactly how users interact with your site
 * - Heatmaps: See where users click, scroll, and spend time
 * - Rage Clicks: Identify frustration points
 * - Dead Clicks: Find broken UI elements
 * - Quick Back: See pages that make users immediately leave
 *
 * HOW IT WORKS:
 * 1. Loads Clarity tracking script
 * 2. Records user sessions anonymously
 * 3. Data appears in Clarity dashboard (clarity.microsoft.com)
 * 4. No PII (personally identifiable info) is collected
 *
 * SETUP:
 * 1. Sign up at https://clarity.microsoft.com (FREE)
 * 2. Add your website
 * 3. Get Project ID (format: alphanumeric string)
 * 4. Add PUBLIC_CLARITY_PROJECT_ID to .env
 *
 * BEST PRACTICES:
 * - Review heatmaps weekly to optimize UX
 * - Watch session recordings of error pages
 * - Use filters to segment by device/country
 * - Set up Goals to track conversions
 *
 * GDPR COMPLIANT: Clarity doesn't collect PII
 */

const clarityProjectId = (import.meta.env.PUBLIC_CLARITY_PROJECT_ID ||
                          (typeof window !== 'undefined' && window.__APP_CONFIG__?.PUBLIC_CLARITY_PROJECT_ID)) || '';

const shouldRender = clarityProjectId && clarityProjectId.length > 0;
---

{shouldRender && (
  <script is:inline define:vars={{ clarityProjectId }}>
    (function(c,l,a,r,i,t,y){
      c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
      t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
      y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
    })(window, document, "clarity", "script", clarityProjectId);
  </script>
)}
