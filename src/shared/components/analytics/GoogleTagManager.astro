<!--
  Google Tag Manager (GTM) Component

  PURPOSE: Central hub for managing ALL tracking tags via GTM dashboard

  MANAGES (via GTM Dashboard):
  - Google Analytics 4 (GA4)
  - Microsoft Clarity
  - Cookiebot CMP (Cookie Consent)
  - Any other tracking pixels/tags

  HOW IT WORKS:
  1. Loads GTM container script in <head>
  2. Creates dataLayer for event tracking
  3. GTM dashboard controls which tags fire and when

  SETUP:
  1. Get GTM ID from https://tagmanager.google.com (format: GTM-XXXXXXX)
  2. Add PUBLIC_GTM_ID to .env
  3. Configure tags in GTM dashboard (GA4, Clarity, Cookiebot)
  4. Add <noscript> fallback in <body> of Layout.astro

  BENEFITS:
  - Add/remove tracking scripts without code changes
  - Better performance (tags load asynchronously)
  - Single source of truth for all tracking
  - Easier consent management via Cookiebot
-->
<script>
  import { getAPIConfig } from '@configs/api-config';

  const config = getAPIConfig();
  const gtmId = config.gtmId;

  // Only initialize if GTM ID is provided and not placeholder
  if (gtmId && gtmId !== 'GTM-XXXXXXX' && gtmId.length > 0) {
    // Initialize Google Tag Manager (Official GTM snippet)
    (window as any).dataLayer = (window as any).dataLayer || [];
    (window as any).dataLayer.push({
      'gtm.start': new Date().getTime(),
      event: 'gtm.js'
    });

    const firstScript = document.getElementsByTagName('script')[0];
    const gtmScript = document.createElement('script') as HTMLScriptElement;
    gtmScript.async = true;
    gtmScript.src = 'https://www.googletagmanager.com/gtm.js?id=' + gtmId;

    if (firstScript && firstScript.parentNode) {
      firstScript.parentNode.insertBefore(gtmScript, firstScript);
    }
  }
</script>
