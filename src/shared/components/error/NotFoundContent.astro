---
import { ROUTES } from '@/routes/routeConfig';

interface Props {
  title?: string;
  message?: string;
  showQuickLinks?: boolean;
}

const {
  title = 'Page Not Found',
  message = "Sorry, the page you are looking for doesn't exist or has been moved.",
  showQuickLinks = true,
} = Astro.props;
---

<div class="container mx-auto px-4 py-16">
  <div class="max-w-md mx-auto text-center">
    <div class="mb-8">
      <h1 class="text-6xl font-bold text-gray-400 mb-4">404</h1>
      <h2 class="text-2xl font-semibold text-gray-800 mb-2">
        {title}
      </h2>
      <p class="text-gray-600">
        {message}
      </p>
    </div>

    <div class="space-y-4">
      <a
        href={ROUTES.HOME}
        class="inline-block px-6 py-3 bg-primary text-white rounded-md hover:bg-primary-dark transition-colors font-bold"
      >
        Go Home
      </a>

      {
        showQuickLinks && (
          <div class="text-sm text-gray-500">
            <p>Or try one of these links:</p>
            <div class="mt-2 space-x-4">
              <a href="/industries/fmcg" class="text-primary hover:underline">
                FMCG
              </a>
              <a
                href="/industries/advertising"
                class="text-primary hover:underline"
              >
                Advertising
              </a>
              <a
                href="/industries/technology"
                class="text-primary hover:underline"
              >
                Technology
              </a>
            </div>
          </div>
        )
      }
    </div>
  </div>
</div>
