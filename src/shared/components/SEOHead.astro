---
/**
 * SEOHead Component
 * Comprehensive SEO meta tags following PRO India SEO Guidelines
 *
 * Guidelines Requirements:
 * - Meta Title: 60 characters max, meaningful, includes keywords
 * - Meta Description: 160 characters max, meaningful, generates curiosity
 * - Open Graph tags for social sharing
 * - Twitter Card tags
 * - Canonical URL
 *
 * IMAGE HANDLING:
 * - Uses Astro's optimized image imports (with hashed filenames)
 * - Works correctly in Docker/SSR deployments
 * - Supports both ImageMetadata and string URLs
 */

import { getAPIConfig } from '@/core/configs/api-config';
import { getSEOImageUrl } from '@utils/seo-images';
import type { ImageMetadata } from 'astro';
import defaultOgImageImport from '@assets/images/og-default.png';

export interface Props {
  title: string; // Max 60 characters
  description: string; // Max 160 characters
  keywords?: string; // Comma-separated keywords
  ogImage?: ImageMetadata | string; // Open Graph image (ImageMetadata or URL)
  ogType?: string; // Page type (website, article, etc.)
  canonical?: string; // Canonical URL
  noindex?: boolean; // Prevent indexing
  nofollow?: boolean; // Prevent following links
  structuredData?: object; // Schema.org structured data (JSON-LD)
}

const {
  title,
  description,
  keywords,
  ogImage,
  ogType = 'website',
  canonical,
  noindex = false,
  nofollow = false,
  structuredData,
} = Astro.props;

const config = getAPIConfig();
const siteUrl = config.siteURL || 'https://www.thoughtmetrics.com';

// Build full URL for canonical and OG
const currentUrl = canonical || new URL(Astro.url.pathname, siteUrl).href;

// Get optimized OG image URL (handles ImageMetadata, string URLs, and fallback)
const ogImagePath = ogImage
  ? await getSEOImageUrl(ogImage, 'og-default.png')
  : defaultOgImageImport.src;

// Convert to absolute URL for social media crawlers
const ogImageUrl = ogImagePath.startsWith('http')
  ? ogImagePath
  : new URL(ogImagePath, siteUrl).href;

// Build robots meta content
const robotsContent = [
  noindex ? 'noindex' : 'index',
  nofollow ? 'nofollow' : 'follow',
].join(', ');

// Validate character lengths (in development only)
if (import.meta.env.DEV) {
  if (title.length > 60) {
    console.warn(
      `⚠️ SEO Warning: Title exceeds 60 characters (${title.length}): "${title}"`
    );
  }
  if (description.length > 160) {
    console.warn(
      `⚠️ SEO Warning: Description exceeds 160 characters (${description.length}): "${description}"`
    );
  }
}
---

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
{keywords && <meta name="keywords" content={keywords} />}
<meta name="robots" content={robotsContent} />

<!-- Canonical URL -->
<link rel="canonical" href={currentUrl} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={currentUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:site_name" content="Thought Metrics" />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={currentUrl} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />

<!-- Additional SEO -->
<meta name="author" content="Thought Metrics" />
<meta name="language" content="English" />
<meta name="revisit-after" content="7 days" />

<!-- Structured Data (JSON-LD) -->
{
  structuredData && (
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  )
}
