---
import LandingLayout from '@/layouts/LandingLayout.astro';
import RespondentLandingPage from '@/shared/screens/landing/respondent-landing/RespondentLandingPage';
import { contentService } from '@/services/strapi-api/content.service';
import { ContentCategory } from '@/core/types/content.type';

const seoContent = {
  title: 'Join Our Panel - Thought Metrics',
  description: 'Join our research panel and share your opinions',
};

// Fetch blog data on the server for SSR
let blogData = null;
try {
  const blogItems = await contentService.getBlogContents({
    type: [],
    category: [ContentCategory.PARTICIPANT_EXPERIENCE],
    limit: 4,
  });
  blogData = {
    title: 'Participant Experience',
    items: blogItems,
  };
} catch (error) {
  console.error('Failed to fetch blog data:', error);
}
---

<LandingLayout
  title={seoContent.title}
  description={seoContent.description}
>
  <RespondentLandingPage client:load blogData={blogData} />
</LandingLayout>
