---
import PolicyHeroSection from '@/shared/ui/templates/policy-hero-section';
import { termsAndConditionsContent } from './constant';
import PresentationLayout from '@/layouts/PresentationLayout.astro';

const { title = 'Terms & Conditions', description = 'Thought Metrics - Terms & Conditions' } = Astro.props;
---

<PresentationLayout title={title} description={description}>
  <PolicyHeroSection
    client:load
    content={termsAndConditionsContent.content}
    head={termsAndConditionsContent.head}
  />
</PresentationLayout>
