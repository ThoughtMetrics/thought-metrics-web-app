---
// src/pages/index.astro
import PresentationLayout from '@layouts/PresentationLayout.astro';
import { contentService } from '@/services/strapi-api/content.service';
import B2BServices from '@screens/home/components/b2b-services';
import HeroCarousel from '@screens/home/components/hero-carousel';
import SolutionInsights from '@screens/home/components/solutions-insights';
import Industries from '@screens/home/components/industries';
import Blogs from '@screens/home/components/blogs';

const seoContent = {
  title: 'Home - Thought Metrics',
  description: 'Welcome to our platform',
  keywords: 'research, analytics, insights',
};

// Fetch blog data on the server for SSR
let blogData = null;
try {
  const blogItems = await contentService.getBlogContents({
    type: [],
    category: [],
    limit: 4,
  });
  blogData = {
    title: 'Fresh Ideas to Help You Reach New Heights.',
    items: blogItems,
  };
} catch (error) {
  console.error('Failed to fetch blog data:', error);
}
---

<PresentationLayout
  title={seoContent.title}
  description={seoContent.description}
  keywords={seoContent.keywords}
>
  <HeroCarousel client:load />
  <SolutionInsights client:load />
  <B2BServices />
  <Industries client:load />
  <Blogs blogData={blogData} client:load />
</PresentationLayout>
