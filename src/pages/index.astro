---
// src/pages/index.astro
import PresentationLayout from '@layouts/PresentationLayout.astro';
import { contentService } from '@/services/strapi-api/content.service';
import HeroCarousel from '@screens/home/components/hero-carousel';
import StatsRibbon from '@screens/home/components/stats-ribbon';
import MethodsBentoGrid from '@screens/home/components/b2b-services';
import Industries from '@screens/home/components/industries';
import CTASection from '@screens/home/components/solutions-insights';
import { seoConfig } from '@/core/constants/seo.constants';
import { buildHomepageSchema } from '@/core/utils/schema-builder';

const seoContent = {
  title: 'Thought Metrics | User Driven Market Research & Insights',
  description: 'Full-service market research firm specializing in focus groups, surveys, and AI-powered analytics. Delivering actionable insights for data-driven decisions.',
  keywords: 'market research, AI insights, focus groups, online surveys, offline surveys, verbatim analysis, analytics platform, research technology, survey app, respondent engagement',
};

const structuredData = buildHomepageSchema(seoConfig);
---

<PresentationLayout
  title={seoContent.title}
  description={seoContent.description}
  keywords={seoContent.keywords}
  structuredData={structuredData}
>
  <HeroCarousel client:load />
  <StatsRibbon />
  <MethodsBentoGrid />
  <Industries client:load />
  <CTASection />
</PresentationLayout>
