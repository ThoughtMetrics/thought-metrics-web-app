---
import IntractionLayout from '@/layouts/IntractionLayout.astro';
import RespondentSignUpWrapper from '@/shared/screens/auth/respondent-sign-up';
import AuthRedirectHandler from '@/shared/components/AuthRedirectHandler';

const seoContent = {
  title: 'Sign Up | Create Account - Thought Metrics',
  description: 'Create your Thought Metrics account today. Join our research panel, participate in surveys, earn rewards, and help brands make better decisions.',
};
---

<IntractionLayout title={seoContent.title} description={seoContent.description}>
  <AuthRedirectHandler client:only="react" />
  <RespondentSignUpWrapper client:only="react" />
</IntractionLayout>
