---
import PresentationLayout from '@/layouts/PresentationLayout.astro';
import ContentHeroSection from '@/shared/screens/resources/components/articles-hero-section';
import ContentBentoGridWrapper from '@/shared/screens/resources/components/content-bento-grid-wrapper';

const seoContent = {
  title: 'Research Insights & Articles | Thought Metrics Resources',
  description: 'Explore data-driven research insights, industry trends, and expert analysis. Centralized intelligence helping you make smarter, informed business decisions.',
};
---

<PresentationLayout
  title={seoContent.title}
  description={seoContent.description}
>
  <ContentHeroSection
    heroSection={{
      title: 'ThoughtMetrics Insights',
      description: 'Data-Driven Research, Centralized Intelligence',
    }}
  />
  <ContentBentoGridWrapper client:only="react" />
</PresentationLayout>
