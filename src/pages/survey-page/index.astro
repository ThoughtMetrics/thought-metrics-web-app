---
import PresentationLayout from '@/layouts/PresentationLayout.astro';
import AppWrapper from '@/shared/components/AppWrapper';
import SurveyPage from './SurveyPageComponent';

const seoContent = {
  title: 'My Surveys - Thought Metrics',
  description: 'View and complete your surveys',
};
---

<PresentationLayout
  title={seoContent.title}
  description={seoContent.description}
>
  <AppWrapper client:only="react">
    <SurveyPage />
  </AppWrapper>
</PresentationLayout>
