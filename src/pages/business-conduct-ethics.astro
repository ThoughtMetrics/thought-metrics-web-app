---
import PolicyHeroSection from '@/shared/ui/templates/policy-hero-section';
import { businessConductEthicsContent } from '@/core/constants/page-constants/business-conduct-ethics-constant';
import PresentationLayout from '@/layouts/PresentationLayout.astro';

const {
  title = 'Business Conduct & Ethics | Thought Metrics',
  description = 'Our business conduct and ethics guidelines. Committed to integrity, transparency, and ethical practices in all market research activities and client engagements.'
} = Astro.props;
---

<PresentationLayout title={title} description={description}>
  <PolicyHeroSection
    client:load
    content={businessConductEthicsContent.content}
    head={businessConductEthicsContent.head}
  />
</PresentationLayout>
