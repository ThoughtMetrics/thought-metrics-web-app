---
import PresentationLayout from '@layouts/PresentationLayout.astro';
import ResearchMethodQuantitativeResearch from './QuantitativeResearchPage';
import { contentService } from '@/services/strapi-api/content.service';
import { ContentCategory } from '@/core/types/content.type';

const seoContent = {
  title: 'Quantitative Research - Thought Metrics',
  description: 'Quantitative Research Methods and Insights',
};

// Fetch blog data on the server for SSR
let blogData = null;
try {
  const blogItems = await contentService.getBlogContents({
    type: [],
    category: [ContentCategory.QUANTITATIVE_RESEARCH],
    limit: 4,
  });
  blogData = {
    title: 'Quantitative Research Insights',
    items: blogItems,
  };
} catch (error) {
  console.error('Failed to fetch blog data:', error);
}
---

<PresentationLayout
  title={seoContent.title}
  description={seoContent.description}
>
  <ResearchMethodQuantitativeResearch client:load blogData={blogData} />
</PresentationLayout>
