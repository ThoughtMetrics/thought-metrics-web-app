---
import PresentationLayout from '@/layouts/PresentationLayout.astro';
import ResearchMethodFocusGroup from '@/shared/screens/research-methods/focus-group/FocusGroupPage';
import { contentService } from '@/services/strapi-api/content.service';
import { ContentCategory } from '@/core/types/content.type';
import { seoConfig } from '@/core/constants/seo.constants';
import { buildStandardPageSchema } from '@/core/utils/schema-builder';
import { generateBreadcrumbsFromPath } from '@/routes/routeConfig';

const seoContent = {
  title: 'Focus Groups | Consumer Insights - Thought Metrics',
  description:
    "Get inside your customer's mind. Expertly moderated focus groups—online or in-person—uncovering real motivations, emotions, and decisions behind behavior.",
  keywords:
    'focus group discussions, qualitative research, consumer insights, online focus groups, in-person focus groups, market research, group moderation, UX research, product testing, customer behavior',
};

// Generate breadcrumbs and structured data for SEO
const breadcrumbs = generateBreadcrumbsFromPath(Astro.url.pathname);
const pageUrl = new URL(Astro.url.pathname, seoConfig.siteUrl).href;
const structuredData = buildStandardPageSchema(
  seoConfig,
  pageUrl,
  'Focus Group Discussions',
  breadcrumbs
);

// Fetch blog data on the server for SSR
let blogData = null;
try {
  const blogItems = await contentService.getBlogContents({
    type: [],
    category: [ContentCategory.FOCUS_GROUP],
    limit: 4,
  });
  blogData = {
    title: 'Focus Group Insights',
    items: blogItems,
  };
} catch (error) {
  console.error('Failed to fetch blog data:', error);
}
---

<PresentationLayout
  title={seoContent.title}
  description={seoContent.description}
  structuredData={structuredData}
>
  <ResearchMethodFocusGroup client:load blogData={blogData} />
</PresentationLayout>
