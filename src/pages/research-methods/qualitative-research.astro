---
import PresentationLayout from '@/layouts/PresentationLayout.astro';
import ResearchMethodQualitativeResearch from '@/shared/screens/research-methods/qualitative-research/QualitativeResearchPage';
import { contentService } from '@/services/strapi-api/content.service';
import { ContentCategory } from '@/core/types/content.type';
import { seoConfig } from '@/core/constants/seo.constants';
import { buildStandardPageSchema } from '@/core/utils/schema-builder';
import { generateBreadcrumbsFromPath } from '@/routes/routeConfig';

const seoContent = {
  title: 'Qualitative Research | Deep Human Insights & Recruitment',
  description: 'Uncover the why behind behavior. Qualitative research through intelligent recruitment, digital and in-person methods, and high-integrity data collection.',
  keywords: 'qualitative research, qualitative recruitment, focus groups, ethnography, in-depth interviews, user testing, qualitative analysis, research panel, consumer behavior insights, qualitative methodology',
};

// Generate breadcrumbs and structured data for SEO
const breadcrumbs = generateBreadcrumbsFromPath(Astro.url.pathname);
const pageUrl = new URL(Astro.url.pathname, seoConfig.siteUrl).href;
const structuredData = buildStandardPageSchema(
  seoConfig,
  pageUrl,
  'Qualitative Research',
  breadcrumbs
);

// Fetch blog data on the server for SSR
let blogData = null;
try {
  const blogItems = await contentService.getBlogContents({
    type: [],
    category: [ContentCategory.QUALITATIVE_RESEARCH],
    limit: 4,
  });
  blogData = {
    title: 'Qualitative Research Insights',
    items: blogItems,
  };
} catch (error) {
  console.error('Failed to fetch blog data:', error);
}
---

<PresentationLayout
  title={seoContent.title}
  description={seoContent.description}
  structuredData={structuredData}
>
  <ResearchMethodQualitativeResearch client:load blogData={blogData} />
</PresentationLayout>
