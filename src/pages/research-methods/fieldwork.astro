---
import PresentationLayout from '@/layouts/PresentationLayout.astro';
import ResearchMethodFieldwork from '@/shared/screens/research-methods/fieldwork/FieldworkPage';
import { contentService } from '@/services/strapi-api/content.service';
import { ContentCategory } from '@/core/types/content.type';
import { seoConfig } from '@/core/constants/seo.constants';
import { buildStandardPageSchema } from '@/core/utils/schema-builder';
import { generateBreadcrumbsFromPath } from '@/routes/routeConfig';

const seoContent = {
  title: 'Recruitment & Fieldwork | Market Research - Thought Metrics',
  description: 'Leave the logistics to us. Expert recruitment and fieldwork services—sourcing precise audiences, managing data collection, and ensuring research quality.',
  keywords: 'fieldwork services, market research recruitment, data collection, fieldwork management, qualitative fieldwork, quantitative fieldwork, research logistics, sample management, respondent recruitment, research execution',
};

// Generate breadcrumbs and structured data for SEO
const breadcrumbs = generateBreadcrumbsFromPath(Astro.url.pathname);
const pageUrl = new URL(Astro.url.pathname, seoConfig.siteUrl).href;
const structuredData = buildStandardPageSchema(
  seoConfig,
  pageUrl,
  'Recruitment & Fieldwork',
  breadcrumbs
);

// Fetch blog data on the server for SSR
let blogData = null;
try {
  const blogItems = await contentService.getBlogContents({
    type: [],
    category: [ContentCategory.FIELDWORK],
    limit: 4,
  });
  blogData = {
    title: 'Fieldwork Insights',
    items: blogItems,
  };
} catch (error) {
  console.error('Failed to fetch blog data:', error);
}
---

<PresentationLayout
  title={seoContent.title}
  description={seoContent.description}
  structuredData={structuredData}
>
  <ResearchMethodFieldwork client:load blogData={blogData} />
</PresentationLayout>
