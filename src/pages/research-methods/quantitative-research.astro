---
import PresentationLayout from '@layouts/PresentationLayout.astro';
import ResearchMethodQuantitativeResearch from '@/shared/screens/research-methods/quantitative-research/QuantitativeResearchPage';
import { contentService } from '@/services/strapi-api/content.service';
import { ContentCategory } from '@/core/types/content.type';

const seoContent = {
  title: 'Quantitative Research | Data-Driven Insights & Advanced Analytics by Thought Metrics',
  description: 'Make decisions backed by data. Thought Metrics delivers quantitative research with smart survey design, robust sampling, and advanced analytics—powering confidence, clarity, and growth.',
    keywords: 'quantitative research, data analytics, survey design, market research, advanced analytics, conjoint analysis, MaxDiff, segmentation research, predictive analytics, statistical modeling',
};

// Fetch blog data on the server for SSR
let blogData = null;
try {
  const blogItems = await contentService.getBlogContents({
    type: [],
    category: [ContentCategory.QUANTITATIVE_RESEARCH],
    limit: 4,
  });
  blogData = {
    title: 'Quantitative Research Insights',
    items: blogItems,
  };
} catch (error) {
  console.error('Failed to fetch blog data:', error);
}
---

<PresentationLayout
  title={seoContent.title}
  description={seoContent.description}
>
  <ResearchMethodQuantitativeResearch client:load blogData={blogData} />
</PresentationLayout>
