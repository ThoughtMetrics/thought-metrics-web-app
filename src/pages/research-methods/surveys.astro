---
import PresentationLayout from '@/layouts/PresentationLayout.astro';
import ResearchMethodSurveys from '@/shared/screens/research-methods/surveys/SurveysPage';
import { seoConfig } from '@/core/constants/seo.constants';
import { buildStandardPageSchema } from '@/core/utils/schema-builder';
import { generateBreadcrumbsFromPath } from '@/routes/routeConfig';

const seoContent = {
  title: 'Survey Research | Online, Phone & Mixed-Mode Solutions',
  description: 'Survey smarter with Thought Metrics. We manage online, phone, and mixed-mode surveys that reach the right audiences and deliver high-quality, actionable data.',
  keywords: 'survey research, online surveys, phone surveys, mixed mode surveys, survey design, data collection, survey analytics, quantitative surveys, CATI, survey insights',
};

// Generate breadcrumbs and structured data for SEO
const breadcrumbs = generateBreadcrumbsFromPath(Astro.url.pathname);
const pageUrl = new URL(Astro.url.pathname, seoConfig.siteUrl).href;
const structuredData = buildStandardPageSchema(
  seoConfig,
  pageUrl,
  'Surveys',
  breadcrumbs
);
---

<PresentationLayout
  title={seoContent.title}
  description={seoContent.description}
  structuredData={structuredData}
>
  <ResearchMethodSurveys client:load />
</PresentationLayout>
