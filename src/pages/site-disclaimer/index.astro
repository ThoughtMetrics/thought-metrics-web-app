---
import PolicyHeroSection from '@/shared/ui/templates/policy-hero-section';
import { siteDisclaimerContent } from './constant';
import PresentationLayout from '@/layouts/PresentationLayout.astro';

const { title = 'Site Disclaimer', description = 'Thought Metrics - Site Disclaimer' } = Astro.props;
---

<PresentationLayout title={title} description={description}>
  <PolicyHeroSection
    client:load
    content={siteDisclaimerContent.content}
    head={siteDisclaimerContent.head}
  />
</PresentationLayout>
