---
import PolicyHeroSection from '@ui/templates/policy-hero-section';
import { aiPolicyContent } from '@constants/page-constants/ai-policy-constant';
import PresentationLayout from '@layouts/PresentationLayout.astro';
const {
  title = 'AI Policy | Responsible AI Use - Thought Metrics',
  description = 'Learn about Thought Metrics\' AI policy, our commitment to responsible AI use, data protection, and ethical research practices in market research and analytics.'
} = Astro.props;
---

<PresentationLayout title={title} description={description}>
  <PolicyHeroSection
    client:load
    content={aiPolicyContent.content}
    head={title}
  />
</PresentationLayout>
