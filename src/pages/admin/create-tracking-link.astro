---
import IntractionLayout from '@/layouts/IntractionLayout.astro';
import AdminRouteGuard from '@/shared/components/guards/AdminRouteGuard';

const seoContent = {
  title: 'Create Tracking Link | Admin | Thought Metrics',
  description: 'Create and manage tracking links for campaigns',
};
---

<IntractionLayout title={seoContent.title} description={seoContent.description}>
  <AdminRouteGuard client:only="react">
    <div class="h-full overflow-y-scroll bg-gray-50 py-12 px-4 text-text-dark">
      <div class="max-w-4xl mx-auto">
        <h1 class="text-3xl font-bold text-gray-900 mb-8">
          Create Tracking Link
        </h1>

        <!-- Link Creation Form -->
        <div class="bg-white rounded-lg shadow-lg p-8 mb-8">
          <form id="linkForm" class="space-y-6">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">
                Campaign Name *
              </label>
              <input
                type="text"
                name="name"
                required
                placeholder="e.g., Email Campaign - January 2024"
                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-primary"
              />
              <p class="mt-1 text-xs text-gray-500">
                Internal name to identify this campaign
              </p>
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">
                Destination URL *
              </label>
              <input
                type="url"
                name="destinationUrl"
                required
                value="http://localhost:4200/sign-up"
                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-primary"
              />
              <p class="mt-1 text-xs text-gray-500">
                Where the link redirects to
              </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">
                  UTM Source
                </label>
                <input
                  type="text"
                  name="utmSource"
                  placeholder="e.g., email, facebook, instagram"
                  class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-primary"
                />
                <p class="mt-1 text-xs text-gray-500">
                  Traffic source: email, social, search
                </p>
              </div>

              <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">
                  UTM Medium
                </label>
                <input
                  type="text"
                  name="utmMedium"
                  placeholder="e.g., newsletter, paid_social, cpc"
                  class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-primary"
                />
                <p class="mt-1 text-xs text-gray-500">Marketing medium</p>
              </div>
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">
                UTM Campaign
              </label>
              <input
                type="text"
                name="utmCampaign"
                placeholder="e.g., summer_2024, product_launch"
                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-primary"
              />
              <p class="mt-1 text-xs text-gray-500">Campaign identifier</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">
                  UTM Term
                </label>
                <input
                  type="text"
                  name="utmTerm"
                  placeholder="e.g., survey panel, earn money"
                  class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-primary"
                />
                <p class="mt-1 text-xs text-gray-500">
                  Paid keywords (optional)
                </p>
              </div>

              <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">
                  UTM Content
                </label>
                <input
                  type="text"
                  name="utmContent"
                  placeholder="e.g., banner_a, text_link_1"
                  class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-primary"
                />
                <p class="mt-1 text-xs text-gray-500">
                  Content variant (for A/B testing)
                </p>
              </div>
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">
                Post-Signup Redirect
              </label>
              <select
                name="postSignupRedirect"
                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-primary"
              >
                <option value="/survey-campaign"
                  >Onboarding Survey (/survey-campaign)</option
                >
                <option value="/survey-boards"
                  >Survey Boards (/survey-boards)</option
                >
                <option value="/dashboard">User Dashboard (/dashboard)</option>
              </select>
              <p class="mt-1 text-xs text-gray-500">
                Where user goes after signup
              </p>
            </div>

            <div class="flex items-center">
              <input
                type="checkbox"
                name="redirectToSignup"
                id="redirectToSignup"
                checked
                class="w-4 h-4 text-primary focus:ring-primary border-gray-300 rounded"
              />
              <label for="redirectToSignup" class="ml-2 text-sm text-gray-700">
                Auto-redirect to signup page
              </label>
            </div>

            <div class="flex gap-4">
              <button
                type="submit"
                class="flex-1 bg-primary text-white px-6 py-3 rounded-lg font-medium hover:bg-primary/90 transition-colors"
              >
                Create Tracking Link
              </button>
              <button
                type="button"
                id="viewLinksBtn"
                class="bg-gray-200 text-gray-700 px-6 py-3 rounded-lg font-medium hover:bg-gray-300 transition-colors"
              >
                View All Links
              </button>
            </div>
          </form>

          <!-- Success Message -->
          <div
            id="successMessage"
            class="hidden mt-6 p-4 bg-green-50 border border-green-200 rounded-lg"
          >
            <h3 class="text-green-800 font-semibold mb-2">
              ✅ Link Created Successfully!
            </h3>
            <div class="space-y-2">
              <div>
                <p class="text-sm text-green-700 font-medium">Tracking URL:</p>
                <div class="flex items-center gap-2 mt-1">
                  <code
                    id="trackingUrl"
                    class="flex-1 px-3 py-2 bg-white border border-green-300 rounded text-sm text-green-900"
                  ></code>
                  <button
                    id="copyBtn"
                    class="px-4 py-2 bg-green-600 text-white rounded hover:bg-green-700 transition-colors text-sm font-medium"
                  >
                    Copy
                  </button>
                </div>
              </div>
              <div>
                <p class="text-sm text-green-700 font-medium">Short Code:</p>
                <code
                  id="shortCode"
                  class="block mt-1 px-3 py-2 bg-white border border-green-300 rounded text-sm text-green-900"
                ></code>
              </div>
            </div>
          </div>

          <!-- Error Message -->
          <div
            id="errorMessage"
            class="hidden mt-6 p-4 bg-red-50 border border-red-200 rounded-lg"
          >
            <p class="text-red-800"></p>
          </div>
        </div>

        <!-- Existing Links -->
        <div class="bg-white rounded-lg shadow-lg p-8">
          <h2 class="text-xl font-semibold text-gray-900 mb-4">
            Recent Tracking Links
          </h2>
          <div id="linksList" class="space-y-4">
            <p class="text-gray-500 text-center py-8">Loading links...</p>
          </div>
        </div>
      </div>
    </div>

    <script>
      const API_BASE = 'http://localhost:3000/api/v1';

      // Get auth token from Firebase
      async function getAuthHeaders() {
        try {
          const { auth } = await import('@/core/configs/firebase-config');
          const user = auth.currentUser;
          if (!user) throw new Error('Not authenticated');

          const token = await user.getIdToken();
          return {
            Authorization: `Bearer firebase:${token}`,
            'Content-Type': 'application/json',
          };
        } catch (error) {
          console.error('Failed to get auth token:', error);
          throw error;
        }
      }

      // Load existing links
      async function loadLinks() {
        try {
          const headers = await getAuthHeaders();
          const response = await fetch(`${API_BASE}/analytics/links`, {
            headers,
            credentials: 'include',
          });

          if (!response.ok) {
            throw new Error('Failed to load links');
          }

          const result = await response.json();
          const links = result.data;

          const container = document.getElementById('linksList');
          if (!container) return;

          if (links.length === 0) {
            container.innerHTML =
              '<p class="text-gray-500 text-center py-8">No links created yet</p>';
            return;
          }

          container.innerHTML = links
            .slice(0, 10)
            .map(
              (link: any) => `
          <div class="border border-gray-200 rounded-lg p-4 hover:border-primary transition-colors">
            <div class="flex justify-between items-start mb-2">
              <h3 class="font-semibold text-gray-900">${link.name}</h3>
              <span class="px-2 py-1 bg-green-100 text-green-800 text-xs rounded">${link.isActive ? 'Active' : 'Inactive'}</span>
            </div>
            <div class="space-y-1 text-sm text-gray-600 mb-3">
              ${link.utmSource ? `<p><strong>Source:</strong> ${link.utmSource}</p>` : ''}
              ${link.utmMedium ? `<p><strong>Medium:</strong> ${link.utmMedium}</p>` : ''}
              ${link.utmCampaign ? `<p><strong>Campaign:</strong> ${link.utmCampaign}</p>` : ''}
            </div>
            <div class="flex items-center gap-2 mb-2">
              <code class="flex-1 px-2 py-1 bg-gray-100 rounded text-xs text-gray-800">${link.fullTrackingUrl}</code>
              <button onclick="copyLink('${link.fullTrackingUrl}')" class="px-3 py-1 bg-primary text-white rounded text-xs hover:bg-primary/90">
                Copy
              </button>
            </div>
            ${
              link.stats
                ? `
              <div class="flex gap-4 text-xs text-gray-500 mt-2">
                <span>👥 ${link.stats.uniqueVisitors || 0} visitors</span>
                <span>✅ ${link.stats.registrations || 0} signups</span>
              </div>
            `
                : ''
            }
          </div>
        `
            )
            .join('');
        } catch (error) {
          console.error('Error loading links:', error);
          const container = document.getElementById('linksList');
          if (container) {
            container.innerHTML =
              '<p class="text-red-500 text-center py-8">Failed to load links. Make sure the API is running.</p>';
          }
        }
      }

      // Create link
      const form = document.getElementById('linkForm') as HTMLFormElement;
      form?.addEventListener('submit', async (e) => {
        e.preventDefault();

        const formData = new FormData(form);
        const data = {
          name: formData.get('name'),
          destinationUrl: formData.get('destinationUrl'),
          utmSource: formData.get('utmSource') || undefined,
          utmMedium: formData.get('utmMedium') || undefined,
          utmCampaign: formData.get('utmCampaign') || undefined,
          utmTerm: formData.get('utmTerm') || undefined,
          utmContent: formData.get('utmContent') || undefined,
          postSignupRedirect: formData.get('postSignupRedirect'),
          redirectToSignup: formData.get('redirectToSignup') === 'on',
        };

        try {
          const headers = await getAuthHeaders();
          const response = await fetch(`${API_BASE}/analytics/links`, {
            method: 'POST',
            headers,
            credentials: 'include',
            body: JSON.stringify(data),
          });

          if (!response.ok) {
            const error = await response.json();
            throw new Error(error.message || 'Failed to create link');
          }

          const result = await response.json();
          const link = result.data;

          // Show success message
          const successMsg = document.getElementById('successMessage');
          const errorMsg = document.getElementById('errorMessage');
          const trackingUrlEl = document.getElementById('trackingUrl');
          const shortCodeEl = document.getElementById('shortCode');

          if (successMsg && trackingUrlEl && shortCodeEl) {
            trackingUrlEl.textContent = link.fullTrackingUrl;
            shortCodeEl.textContent = link.shortCode;
            successMsg.classList.remove('hidden');
          }

          if (errorMsg) {
            errorMsg.classList.add('hidden');
          }

          // Reload links list
          loadLinks();

          // Reset form
          form.reset();
        } catch (error: any) {
          const errorMsg = document.getElementById('errorMessage');
          const successMsg = document.getElementById('successMessage');

          if (errorMsg) {
            errorMsg.querySelector('p')!.textContent = error.message;
            errorMsg.classList.remove('hidden');
          }

          if (successMsg) {
            successMsg.classList.add('hidden');
          }
        }
      });

      // Copy button
      document.getElementById('copyBtn')?.addEventListener('click', () => {
        const trackingUrlEl = document.getElementById('trackingUrl');
        if (trackingUrlEl) {
          navigator.clipboard.writeText(trackingUrlEl.textContent || '');
          alert('Link copied to clipboard!');
        }
      });

      // Copy link function
      (window as any).copyLink = (url: string) => {
        navigator.clipboard.writeText(url);
        alert('Link copied to clipboard!');
      };

      // View all links button
      document.getElementById('viewLinksBtn')?.addEventListener('click', () => {
        window.location.href = '/admin/analytics';
      });

      // Load links on page load
      loadLinks();
    </script>
  </AdminRouteGuard>
</IntractionLayout>
