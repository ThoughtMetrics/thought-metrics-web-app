---
import CampaignLayout from '@/layouts/CampaignLayout.astro';
import SurveyFormWrapper from '@/shared/screens/survey-campaign/survey-form-wrapper';

const { id } = Astro.params;

const seoContent = {
  title: 'Complete Survey | Thought Metrics',
  description: 'Complete your survey to earn rewards.',
};
---

<CampaignLayout title={seoContent.title} description={seoContent.description}>
  <SurveyFormWrapper client:only="react" surveyId={id || ''} />
</CampaignLayout>
