---
import IntractionLayout from '@/layouts/IntractionLayout.astro';
import UnsubscribeWrapper from '@/shared/screens/auth/unsubscribe';

/**
 * SEO Configuration (Following PRO India SEO Guidelines)
 * - Title: Max 60 characters (current: 32 chars) ✓
 * - Description: Max 160 characters (current: 96 chars) ✓
 * - Keywords: Relevant terms for search engines
 */
const seoContent = {
  title: 'Unsubscribe | Email Preferences - Thought Metrics',
  description: 'Manage your email preferences and unsubscribe from Thought Metrics communications. Update your subscription settings or opt out anytime.',
  keywords: 'unsubscribe, email preferences, opt out, email settings, manage subscriptions, thought metrics',
  noindex: true, // Prevent indexing of user-specific pages
};
---

<IntractionLayout
  title={seoContent.title}
  description={seoContent.description}
  keywords={seoContent.keywords}
  noindex={seoContent.noindex}
>
  <UnsubscribeWrapper client:only="react" />
</IntractionLayout>
