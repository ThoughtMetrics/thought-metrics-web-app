---
import PresentationLayout from '@/layouts/PresentationLayout.astro';
import AppWrapper from '@/shared/components/AppWrapper';
import OurPanelComponent from './OurPanelComponent';

const seoContent = {
  title: 'Our Panel - Thought Metrics',
  description: 'Discover our diverse and high-quality research panel',
};
---

<PresentationLayout title={seoContent.title} description={seoContent.description}>
  <AppWrapper client:only="react">
    <OurPanelComponent />
  </AppWrapper>
</PresentationLayout>
