---
import PresentationLayout from '@/layouts/PresentationLayout.astro';
import { seoConfig } from '@/core/constants/seo.constants';
import { buildStandardPageSchema } from '@/core/utils/schema-builder';
import { generateBreadcrumbsFromPath } from '@/routes/routeConfig';

const seoContent = {
  title: 'Internet & Media Research | Audience & Content Insights',
  description: 'Understand your audience like never before. Agile internet and media research revealing what drives content engagement, ad impact, and digital platform growth.',
  keywords: 'internet research, media market research, audience insights, advertising research, content testing, digital media analytics, ad effectiveness, platform research, user behavior, creator economy insights',
};

const breadcrumbs = generateBreadcrumbsFromPath(Astro.url.pathname);
const pageUrl = new URL(Astro.url.pathname, seoConfig.siteUrl).href;
const structuredData = buildStandardPageSchema(seoConfig, pageUrl, 'Internet & Media Research', breadcrumbs);
---

<PresentationLayout title={seoContent.title} description={seoContent.description} keywords={seoContent.keywords} structuredData={structuredData}>

  <section class="tm-section relative">
    <div class="tm-container grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div class="z-10">
        <nav class="flex items-center gap-2 mb-6 text-xs text-on-surface-variant">
          <a href="/" class="hover:text-on-surface transition-colors">Home</a><span class="opacity-40">/</span>
          <a href="/industries" class="opacity-60 hover:text-on-surface transition-colors">Industries</a><span class="opacity-40">/</span>
          <span class="text-primary font-medium">Internet &amp; Media</span>
        </nav>
        <span class="chip mb-6 inline-flex">INTERNET &amp; MEDIA</span>
        <h1 class="text-5xl md:text-6xl font-extrabold tracking-tight mb-6 leading-[1.08]">
          Decode Digital Audiences<br /><span class="text-primary italic">Before Your Competitors Do.</span>
        </h1>
        <p class="text-lg text-on-surface-variant max-w-xl mb-10 leading-relaxed">From data to dialogue, uncover what truly drives your audience — content preferences, platform loyalty, subscription decisions, and the moments that shape digital behavior.</p>
        <div class="flex flex-col sm:flex-row gap-4 items-start sm:items-center">
          <a href="/start-your-research" class="btn-primary">Request a Bid</a>
          <a href="#services" class="btn-ghost">Explore Solutions</a>
        </div>
      </div>
      <div class="relative">
        <div class="rounded-[3rem] bg-surface-container-low border border-outline-variant/10 shadow-2xl p-8 flex flex-col gap-4 min-h-[360px]">
          <div class="flex items-center justify-between mb-2">
            <span class="text-sm font-semibold text-on-surface-variant uppercase tracking-widest">Digital Audience Map</span>
            <div class="flex items-center gap-1"><div class="w-2 h-2 rounded-full bg-primary animate-pulse"></div><span class="text-xs text-on-surface-variant">Active</span></div>
          </div>
          <div class="grid grid-cols-2 gap-3">
            {[{label:'Video', sub:'Streaming & OTT', icon:'play_circle', color:'primary'},
              {label:'Social', sub:'Platforms & Communities', icon:'forum', color:'secondary'},
              {label:'Audio', sub:'Podcast & Music', icon:'podcasts', color:'tertiary'},
              {label:'News', sub:'Digital & Print', icon:'article', color:'primary'}
            ].map(({label, sub, icon, color}) => (
              <div class={`flex flex-col gap-2 p-4 rounded-xl bg-surface-container border border-outline-variant/10`}>
                <span class={`material-symbols-outlined text-${color} text-2xl`}>{icon}</span>
                <div><div class="text-sm font-semibold text-on-surface">{label}</div><div class="text-xs text-on-surface-variant">{sub}</div></div>
              </div>
            ))}
          </div>
          <div class="bg-primary/10 rounded-xl p-3 border border-primary/20 mt-auto">
            <div class="text-xs font-semibold text-on-surface mb-1">Multi-Platform Intelligence</div>
            <div class="text-[10px] text-on-surface-variant">Cross-channel audience behavior tracking</div>
          </div>
        </div>
        <div class="absolute -top-4 -right-4 bg-surface-container-high/90 backdrop-blur-xl p-5 rounded-2xl border border-outline-variant/20 shadow-2xl">
          <div class="text-primary text-2xl font-bold mb-0.5">Content</div>
          <div class="text-on-surface-variant text-xs uppercase tracking-wider font-bold">Strategy Research</div>
        </div>
        <div class="absolute -bottom-4 -left-4 bg-surface-container-high/90 backdrop-blur-xl p-5 rounded-2xl border border-outline-variant/20 shadow-2xl">
          <div class="text-secondary text-2xl font-bold mb-0.5">Audience</div>
          <div class="text-on-surface-variant text-xs uppercase tracking-wider font-bold">Segmentation</div>
        </div>
      </div>
    </div>
    <div class="absolute inset-0 pointer-events-none overflow-hidden" style="z-index:-1" aria-hidden="true">
      <div class="absolute top-0 left-0 w-[500px] h-[500px] bg-primary/8 blur-[140px] rounded-full"></div>
    </div>
  </section>

  <section class="bg-surface-container-lowest py-14 border-y border-outline-variant/5">
    <div class="tm-container flex flex-wrap justify-between gap-10 items-center">
      <div class="flex items-center gap-4"><span class="material-symbols-outlined text-4xl text-primary">language</span><div><div class="text-2xl font-bold text-on-surface">Digital Audiences</div><div class="text-on-surface-variant text-sm">Across All Online Platforms</div></div></div>
      <div class="flex items-center gap-4"><span class="material-symbols-outlined text-4xl text-secondary">content_paste</span><div><div class="text-2xl font-bold text-on-surface">Content Strategy</div><div class="text-on-surface-variant text-sm">What Audiences Actually Want</div></div></div>
      <div class="flex items-center gap-4"><span class="material-symbols-outlined text-4xl text-tertiary">subscriptions</span><div><div class="text-2xl font-bold text-on-surface">Subscription Research</div><div class="text-on-surface-variant text-sm">Churn Drivers &amp; Loyalty</div></div></div>
      <div class="flex items-center gap-4"><span class="material-symbols-outlined text-4xl text-primary-container">monetization_on</span><div><div class="text-2xl font-bold text-on-surface">Monetization</div><div class="text-on-surface-variant text-sm">Ad Tolerance &amp; WTP</div></div></div>
    </div>
  </section>

  <section class="tm-section bg-surface" id="services">
    <div class="tm-container">
      <div class="flex flex-col md:flex-row justify-between items-end mb-14 gap-6">
        <div class="max-w-2xl"><p class="section-eyebrow">How We Help</p><h2 class="text-4xl md:text-5xl font-bold mb-5">Research That Keeps Up With <span class="text-secondary">Digital Speed</span></h2><p class="text-lg text-on-surface-variant">The internet never stops evolving — and neither do audience expectations. We help media, tech, and platform businesses stay ahead of the curve.</p></div>
        <a href="/start-your-research" class="btn-ghost flex-shrink-0">Get a Quote</a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="ds-card"><div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center mb-6"><span class="material-symbols-outlined text-primary text-3xl">person_search</span></div><h3 class="text-xl font-bold mb-3 text-on-surface">Audience Profiling &amp; Segmentation</h3><p class="text-on-surface-variant mb-5">Go beyond page views. Understand who your audience is, what they value, how they discover content, and what keeps them coming back — across devices and platforms.</p><div class="flex items-center gap-3 flex-wrap"><span class="chip">BEHAVIORAL DATA</span><span class="chip">PLATFORM LOYALTY</span></div></div>
        <div class="ds-card"><div class="w-12 h-12 rounded-xl bg-secondary/10 flex items-center justify-center mb-6"><span class="material-symbols-outlined text-secondary text-3xl">article</span></div><h3 class="text-xl font-bold mb-3 text-on-surface">Content Strategy &amp; Format Research</h3><p class="text-on-surface-variant mb-5">Find out which content types, topics, formats, and publishing cadences your audience genuinely prefers. Build editorial and product strategy around real user signals — not assumptions.</p><div class="flex items-center gap-3 flex-wrap"><span class="chip">CONTENT FORMATS</span><span class="chip">EDITORIAL STRATEGY</span></div></div>
        <div class="ds-card"><div class="w-12 h-12 rounded-xl bg-tertiary/10 flex items-center justify-center mb-6"><span class="material-symbols-outlined text-tertiary text-3xl">monetization_on</span></div><h3 class="text-xl font-bold mb-3 text-on-surface">Monetization &amp; Subscription Research</h3><p class="text-on-surface-variant mb-5">What are users willing to pay for? What drives churn? How much ad load is too much? We help you find the right monetization model without sacrificing audience trust.</p><div class="flex items-center gap-3 flex-wrap"><span class="chip">CHURN ANALYSIS</span><span class="chip">PRICING RESEARCH</span></div></div>
      </div>
    </div>
  </section>

  <section class="tm-section bg-surface-container-lowest">
    <div class="tm-container">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
        <div>
          <p class="section-eyebrow">Internet & Media Research Questions</p>
          <h2 class="text-4xl md:text-5xl font-bold mb-6">Understand What Keeps <span class="text-primary">Your Audience Coming Back</span></h2>
          <p class="text-lg text-on-surface-variant mb-8 leading-relaxed">The digital landscape is crowded and attention is scarce. We help media and internet companies understand what really drives engagement, loyalty, and monetization at scale.</p>
          <div class="bg-surface-container rounded-2xl p-6 border border-outline-variant/10">
            <div class="flex items-center gap-3 mb-4"><span class="material-symbols-outlined text-secondary text-xl">language</span><span class="font-semibold text-on-surface">Common Research Areas</span></div>
            <ul class="space-y-2">
              <li class="flex items-center gap-2 text-sm text-on-surface-variant"><span class="material-symbols-outlined text-primary text-base">arrow_right</span>Platform usage behavior & switching triggers</li>
              <li class="flex items-center gap-2 text-sm text-on-surface-variant"><span class="material-symbols-outlined text-primary text-base">arrow_right</span>Content preference mapping by segment</li>
              <li class="flex items-center gap-2 text-sm text-on-surface-variant"><span class="material-symbols-outlined text-primary text-base">arrow_right</span>Ad experience & format tolerance research</li>
              <li class="flex items-center gap-2 text-sm text-on-surface-variant"><span class="material-symbols-outlined text-primary text-base">arrow_right</span>Subscription willingness & churn drivers</li>
            </ul>
          </div>
        </div>
        <div class="space-y-3">
          <div class="faq-card"><div class="faq-header"><p class="faq-question">What content formats do your audiences prefer?</p><span class="faq-chevron">&#9660;</span></div><div class="faq-body"><ul><li>Short-form vs. long-form — what holds attention and drives action?</li><li>Video, audio, text — which format performs best for your content goals?</li><li>What topics earn loyal audiences vs. casual one-time visitors?</li></ul></div></div>
          <div class="faq-card"><div class="faq-header"><p class="faq-question">Why are users churning from your platform?</p><span class="faq-chevron">&#9660;</span></div><div class="faq-body"><ul><li>What moments trigger a subscription cancellation or platform exit?</li><li>How does pricing perception affect retention vs. content quality perception?</li><li>Which user segments are most at risk and what would retain them?</li></ul></div></div>
          <div class="faq-card"><div class="faq-header"><p class="faq-question">How do users discover and decide on platforms?</p><span class="faq-chevron">&#9660;</span></div><div class="faq-body"><ul><li>What drives platform switching decisions — content, price, or UX?</li><li>What makes a user recommend a platform to others?</li><li>How does word-of-mouth vs. paid discovery affect user quality and retention?</li></ul></div></div>
          <div class="faq-card"><div class="faq-header"><p class="faq-question">What's the right ad model for your audience?</p><span class="faq-chevron">&#9660;</span></div><div class="faq-body"><ul><li>How much ad load is acceptable before users disengage or churn?</li><li>Ad-supported vs. subscription — which model do users prefer for which content types?</li><li>What ad formats are least intrusive and most effective for your audience?</li></ul></div></div>
          <div class="faq-card"><div class="faq-header"><p class="faq-question">How does your brand rank in the digital ecosystem?</p><span class="faq-chevron">&#9660;</span></div><div class="faq-body"><ul><li>How do users perceive your platform vs. competitors on trust and quality?</li><li>What brand attributes drive loyalty in your content category?</li><li>How does your platform's reputation affect creator and advertiser relationships?</li></ul></div></div>
        </div>
      </div>
    </div>
  </section>

  <section class="tm-section bg-surface" id="cta">
    <div class="tm-container"><div class="cta-card"><div class="cta-content">
      <p class="cta-eyebrow">Get Started Today</p>
      <h2 class="cta-heading">Stay Ahead of Your Audience — Before They Move On.</h2>
      <p class="cta-body">Digital audiences are fluid and fast-moving. Our research helps media, platform, and internet businesses make decisions with the confidence of real human data.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/start-your-research" class="btn-surface">Request a Bid</a>
        <a href="/contact-us" class="btn-cta-frosted">Talk to Our Team</a>
      </div>
    </div><div class="cta-orb cta-orb--tl"></div><div class="cta-orb cta-orb--br"></div></div></div>
  </section>

</PresentationLayout>

<script>
  document.querySelectorAll('.faq-card').forEach(card => {
    card.addEventListener('click', () => {
      const isOpen = card.classList.contains('open');
      document.querySelectorAll('.faq-card').forEach(c => c.classList.remove('open'));
      if (!isOpen) card.classList.add('open');
    });
  });
</script>
