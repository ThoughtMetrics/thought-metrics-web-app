---
import { industries } from '../industries.constant';
import IndustryTemplatePage from '../template';
import PresentationLayout from '@layouts/PresentationLayout.astro';

const seoContent = {
  title: 'Retail - Thought Metrics',
  description: 'Retail and E-commerce Research and Insights',
};
