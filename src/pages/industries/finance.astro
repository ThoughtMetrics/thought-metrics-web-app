---
import PresentationLayout from '@/layouts/PresentationLayout.astro';
import { seoConfig } from '@/core/constants/seo.constants';
import { buildStandardPageSchema } from '@/core/utils/schema-builder';
import { generateBreadcrumbsFromPath } from '@/routes/routeConfig';

const seoContent = {
  title: 'Financial Services & Insurance Research | Market Insights',
  description: 'Navigate change with confidence. Financial services and insurance research revealing customer needs, building trust, and driving smarter, data-backed decisions.',
  keywords: 'financial services research, insurance research, fintech insights, customer trust research, banking market research, financial product testing, risk perception, compliance insights, investment behavior, finance analytics',
};

const breadcrumbs = generateBreadcrumbsFromPath(Astro.url.pathname);
const pageUrl = new URL(Astro.url.pathname, seoConfig.siteUrl).href;
const structuredData = buildStandardPageSchema(seoConfig, pageUrl, 'Financial Services & Insurance Research', breadcrumbs);
---

<PresentationLayout title={seoContent.title} description={seoContent.description} keywords={seoContent.keywords} structuredData={structuredData}>

  <section class="tm-section relative">
    <div class="tm-container grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div class="z-10">
        <nav class="flex items-center gap-2 mb-6 text-xs text-on-surface-variant">
          <a href="/" class="hover:text-on-surface transition-colors">Home</a><span class="opacity-40">/</span>
          <a href="/industries" class="opacity-60 hover:text-on-surface transition-colors">Industries</a><span class="opacity-40">/</span>
          <span class="text-primary font-medium">Financial Services &amp; Insurance</span>
        </nav>
        <span class="chip mb-6 inline-flex">FINANCIAL SERVICES &amp; INSURANCE</span>
        <h1 class="text-5xl md:text-6xl font-extrabold tracking-tight mb-6 leading-[1.08]">
          Navigate the Future of Finance<br /><span class="text-primary italic">With Precision.</span>
        </h1>
        <p class="text-lg text-on-surface-variant max-w-xl mb-10 leading-relaxed">From trust to transformation, uncover insights that drive smarter decisions, stronger customer relationships, and real competitive advantage in banking, insurance, and investment.</p>
        <div class="flex flex-col sm:flex-row gap-4 items-start sm:items-center">
          <a href="/start-your-research" class="btn-primary">Request a Bid</a>
          <a href="#services" class="btn-ghost">Explore Solutions</a>
        </div>
      </div>
      <div class="relative">
        <div class="rounded-[3rem] bg-surface-container-low border border-outline-variant/10 shadow-2xl p-8 flex flex-col gap-4 min-h-[360px]">
          <div class="flex items-center justify-between mb-2">
            <span class="text-sm font-semibold text-on-surface-variant uppercase tracking-widest">Consumer Trust Index</span>
            <div class="flex items-center gap-1"><div class="w-2 h-2 rounded-full bg-secondary animate-pulse"></div><span class="text-xs text-on-surface-variant">Live</span></div>
          </div>
          <div class="grid grid-cols-3 gap-3">
            <div class="bg-surface-container rounded-xl p-3 text-center"><span class="material-symbols-outlined text-primary text-2xl">verified_user</span><div class="text-lg font-extrabold text-primary">7.2</div><div class="text-[10px] text-on-surface-variant">Trust Score</div></div>
            <div class="bg-surface-container rounded-xl p-3 text-center"><span class="material-symbols-outlined text-secondary text-2xl">recommend</span><div class="text-lg font-extrabold text-secondary">+42</div><div class="text-[10px] text-on-surface-variant">NPS Score</div></div>
            <div class="bg-surface-container rounded-xl p-3 text-center"><span class="material-symbols-outlined text-tertiary text-2xl">loyalty</span><div class="text-lg font-extrabold text-tertiary">68%</div><div class="text-[10px] text-on-surface-variant">Loyalty Rate</div></div>
          </div>
          <div class="space-y-3 mt-2">
            <div class="bg-surface-container rounded-xl p-3"><div class="flex justify-between mb-2"><span class="text-xs font-semibold text-on-surface">Product Adoption</span><span class="text-xs font-bold text-primary">74%</span></div><div class="h-2 bg-outline-variant/20 rounded-full"><div class="h-full bg-primary rounded-full" style="width:74%"></div></div></div>
            <div class="bg-surface-container rounded-xl p-3"><div class="flex justify-between mb-2"><span class="text-xs font-semibold text-on-surface">Digital Satisfaction</span><span class="text-xs font-bold text-secondary">81%</span></div><div class="h-2 bg-outline-variant/20 rounded-full"><div class="h-full bg-secondary rounded-full" style="width:81%"></div></div></div>
          </div>
        </div>
        <div class="absolute -top-4 -right-4 bg-surface-container-high/90 backdrop-blur-xl p-5 rounded-2xl border border-outline-variant/20 shadow-2xl">
          <div class="text-primary text-2xl font-bold mb-0.5">Customer</div>
          <div class="text-on-surface-variant text-xs uppercase tracking-wider font-bold">Journey Mapping</div>
        </div>
        <div class="absolute -bottom-4 -left-4 bg-surface-container-high/90 backdrop-blur-xl p-5 rounded-2xl border border-outline-variant/20 shadow-2xl">
          <div class="text-secondary text-2xl font-bold mb-0.5">Competitive</div>
          <div class="text-on-surface-variant text-xs uppercase tracking-wider font-bold">Intelligence</div>
        </div>
      </div>
    </div>
    <div class="absolute inset-0 pointer-events-none overflow-hidden" style="z-index:-1" aria-hidden="true">
      <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-primary/6 blur-[140px] rounded-full"></div>
    </div>
  </section>

  <section class="bg-surface-container-lowest py-14 border-y border-outline-variant/5">
    <div class="tm-container flex flex-wrap justify-between gap-10 items-center">
      <div class="flex items-center gap-4"><span class="material-symbols-outlined text-4xl text-primary">verified_user</span><div><div class="text-2xl font-bold text-on-surface">Consumer Trust</div><div class="text-on-surface-variant text-sm">Brand &amp; Institution Research</div></div></div>
      <div class="flex items-center gap-4"><span class="material-symbols-outlined text-4xl text-secondary">account_balance_wallet</span><div><div class="text-2xl font-bold text-on-surface">Product Adoption</div><div class="text-on-surface-variant text-sm">New Offerings &amp; Features</div></div></div>
      <div class="flex items-center gap-4"><span class="material-symbols-outlined text-4xl text-tertiary">analytics</span><div><div class="text-2xl font-bold text-on-surface">CX Research</div><div class="text-on-surface-variant text-sm">Digital &amp; Branch Experience</div></div></div>
      <div class="flex items-center gap-4"><span class="material-symbols-outlined text-4xl text-primary-container">bar_chart_4_bars</span><div><div class="text-2xl font-bold text-on-surface">Competitive Intel</div><div class="text-on-surface-variant text-sm">Market Positioning</div></div></div>
    </div>
  </section>

  <section class="tm-section bg-surface" id="services">
    <div class="tm-container">
      <div class="flex flex-col md:flex-row justify-between items-end mb-14 gap-6">
        <div class="max-w-2xl"><p class="section-eyebrow">How We Help</p><h2 class="text-4xl md:text-5xl font-bold mb-5">Research for an Industry Built on <span class="text-secondary">Trust and Precision</span></h2><p class="text-lg text-on-surface-variant">Financial services companies need research that is rigorous, compliant, and actionable. We deliver insights across the full customer lifecycle — from acquisition to retention.</p></div>
        <a href="/start-your-research" class="btn-ghost flex-shrink-0">Get a Quote</a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="ds-card"><div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center mb-6"><span class="material-symbols-outlined text-primary text-3xl">shield</span></div><h3 class="text-xl font-bold mb-3 text-on-surface">Trust &amp; Brand Perception Research</h3><p class="text-on-surface-variant mb-5">In finance, trust is the product. We measure consumer confidence, institutional credibility, and brand perception across banking, insurance, and investment — and track how they shift over time.</p><div class="flex items-center gap-3 flex-wrap"><span class="chip">TRUST METRICS</span><span class="chip">BRAND HEALTH</span></div></div>
        <div class="ds-card"><div class="w-12 h-12 rounded-xl bg-secondary/10 flex items-center justify-center mb-6"><span class="material-symbols-outlined text-secondary text-3xl">app_registration</span></div><h3 class="text-xl font-bold mb-3 text-on-surface">Product &amp; Feature Testing</h3><p class="text-on-surface-variant mb-5">Before launching a new product, policy, or digital feature, test it with real customers. Identify what drives adoption, what creates friction, and what pricing is acceptable — so your launch lands right.</p><div class="flex items-center gap-3 flex-wrap"><span class="chip">CONCEPT TESTING</span><span class="chip">PRICING RESEARCH</span></div></div>
        <div class="ds-card"><div class="w-12 h-12 rounded-xl bg-tertiary/10 flex items-center justify-center mb-6"><span class="material-symbols-outlined text-tertiary text-3xl">support_agent</span></div><h3 class="text-xl font-bold mb-3 text-on-surface">Customer Experience &amp; Journey Research</h3><p class="text-on-surface-variant mb-5">Map the complete customer journey — from onboarding to claim resolution. Identify moments of friction, dissatisfaction, and delight. Design experiences that reduce churn and increase lifetime value.</p><div class="flex items-center gap-3 flex-wrap"><span class="chip">CX MAPPING</span><span class="chip">CHURN RESEARCH</span></div></div>
      </div>
    </div>
  </section>

  <section class="tm-section bg-surface-container-lowest">
    <div class="tm-container">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
        <div>
          <p class="section-eyebrow">BFSI Research Questions</p>
          <h2 class="text-4xl md:text-5xl font-bold mb-6">Research That Answers Finance's <span class="text-primary">Hardest Questions</span></h2>
          <p class="text-lg text-on-surface-variant mb-8 leading-relaxed">From digital banking adoption to insurance renewal intent, we help financial institutions understand their customers at a deeper level — and act with greater confidence.</p>
          <div class="bg-surface-container rounded-2xl p-6 border border-outline-variant/10">
            <div class="flex items-center gap-3 mb-4"><span class="material-symbols-outlined text-secondary text-xl">account_balance</span><span class="font-semibold text-on-surface">Common Research Areas</span></div>
            <ul class="space-y-2">
              <li class="flex items-center gap-2 text-sm text-on-surface-variant"><span class="material-symbols-outlined text-primary text-base">arrow_right</span>Consumer trust & institutional brand health</li>
              <li class="flex items-center gap-2 text-sm text-on-surface-variant"><span class="material-symbols-outlined text-primary text-base">arrow_right</span>Digital banking UX & adoption research</li>
              <li class="flex items-center gap-2 text-sm text-on-surface-variant"><span class="material-symbols-outlined text-primary text-base">arrow_right</span>Insurance product & pricing studies</li>
              <li class="flex items-center gap-2 text-sm text-on-surface-variant"><span class="material-symbols-outlined text-primary text-base">arrow_right</span>Investment behavior & attitude research</li>
            </ul>
          </div>
        </div>
        <div class="space-y-3">
          <div class="faq-card"><div class="faq-header"><p class="faq-question">Why do customers switch banks or insurers?</p><span class="faq-chevron">&#9660;</span></div><div class="faq-body"><ul><li>What moments trigger a customer to start looking elsewhere?</li><li>How does digital experience quality influence switching decisions?</li><li>Which competitor attributes are most attractive to your at-risk customers?</li></ul></div></div>
          <div class="faq-card"><div class="faq-header"><p class="faq-question">What drives trust in financial institutions?</p><span class="faq-chevron">&#9660;</span></div><div class="faq-body"><ul><li>Which brand attributes most strongly predict customer trust and loyalty?</li><li>How does a data breach or service failure affect long-term trust?</li><li>What does "trust" mean to different demographic segments in your market?</li></ul></div></div>
          <div class="faq-card"><div class="faq-header"><p class="faq-question">How do customers evaluate financial products?</p><span class="faq-chevron">&#9660;</span></div><div class="faq-body"><ul><li>What features and benefits are most important at each life stage?</li><li>Where do customers go to research financial decisions — and who do they trust?</li><li>What pricing structures and fee models are acceptable vs. deal-breaking?</li></ul></div></div>
          <div class="faq-card"><div class="faq-header"><p class="faq-question">How are fintech players disrupting your market?</p><span class="faq-chevron">&#9660;</span></div><div class="faq-body"><ul><li>Which digital-first competitors are gaining the most share of wallet?</li><li>What do customers value about fintech vs. traditional institutions?</li><li>Which fintech features would your customers most want their bank to offer?</li></ul></div></div>
          <div class="faq-card"><div class="faq-header"><p class="faq-question">What does financial wellbeing mean to your customers?</p><span class="faq-chevron">&#9660;</span></div><div class="faq-body"><ul><li>How do customers define and measure their own financial health?</li><li>What role do they want their financial institution to play in improving it?</li><li>Which tools and services would meaningfully improve their financial confidence?</li></ul></div></div>
        </div>
      </div>
    </div>
  </section>

  <section class="tm-section bg-surface" id="cta">
    <div class="tm-container"><div class="cta-card"><div class="cta-content">
      <p class="cta-eyebrow">Get Started Today</p>
      <h2 class="cta-heading">Make Financial Decisions Backed by What Customers Actually Think.</h2>
      <p class="cta-body">From consumer trust research to product launch validation, our BFSI-specialized insights help you build products, policies, and experiences that earn lasting loyalty.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/start-your-research" class="btn-surface">Request a Bid</a>
        <a href="/contact-us" class="btn-cta-frosted">Talk to Our Team</a>
      </div>
    </div><div class="cta-orb cta-orb--tl"></div><div class="cta-orb cta-orb--br"></div></div></div>
  </section>

</PresentationLayout>

<script>
  document.querySelectorAll('.faq-card').forEach(card => {
    card.addEventListener('click', () => {
      const isOpen = card.classList.contains('open');
      document.querySelectorAll('.faq-card').forEach(c => c.classList.remove('open'));
      if (!isOpen) card.classList.add('open');
    });
  });
</script>
