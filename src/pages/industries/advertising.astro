---
import { industries } from '@/core/constants/page-constants/industries-constant';
import IndustryTemplate from '@layouts/IndustryTemplate.astro';
import { seoConfig } from '@/core/constants/seo.constants';
import { buildStandardPageSchema } from '@/core/utils/schema-builder';
import { generateBreadcrumbsFromPath } from '@/routes/routeConfig';

const seoContent = {
  title: 'Advertising & Marketing Research | Creative Insights',
  description:
    'Turn audience understanding into creative impact. Advertising and marketing research helping brands test ideas, refine campaigns, and measure effectiveness.',
  keywords:
    'advertising research, marketing research, campaign testing, ad effectiveness, audience insights, brand tracking, creative testing, media mix research, digital marketing analytics, ad optimization',
};

// Generate breadcrumbs and structured data for SEO
const breadcrumbs = generateBreadcrumbsFromPath(Astro.url.pathname);
const pageUrl = new URL(Astro.url.pathname, seoConfig.siteUrl).href;
const structuredData = buildStandardPageSchema(
  seoConfig,
  pageUrl,
  'Advertising & Marketing Research',
  breadcrumbs
);
---

<IndustryTemplate
  title={seoContent.title}
  description={seoContent.description}
  industry={industries.advertising}
  structuredData={structuredData}
/>
