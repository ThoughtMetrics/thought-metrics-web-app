---
import PresentationLayout from '@/layouts/PresentationLayout.astro';
import CapabilitiesMarketOpportunityPage from '@/shared/screens/capabilities/market-opportunity/MarketOpportunityPage';
import { seoConfig } from '@/core/constants/seo.constants';
import { buildStandardPageSchema } from '@/core/utils/schema-builder';
import { generateBreadcrumbsFromPath } from '@/routes/routeConfig';

const seoContent = {
  title: 'Market Opportunity Research | Growth & Competitive Edge',
  description: 'Discover untapped potential. Our market opportunity research and competitive intelligence help identify gaps, assess risks, and drive growth and innovation.',
  keywords: 'market opportunity research, competitive intelligence, SWOT analysis, market entry, go-to-market research, competitor benchmarking, business growth strategy, market analysis',
};

// Generate breadcrumbs and structured data for SEO
const breadcrumbs = generateBreadcrumbsFromPath(Astro.url.pathname);
const pageUrl = new URL(Astro.url.pathname, seoConfig.siteUrl).href;
const structuredData = buildStandardPageSchema(
  seoConfig,
  pageUrl,
  'Market Opportunity Research',
  breadcrumbs
);
---

<PresentationLayout
  title={seoContent.title}
  description={seoContent.description}
  structuredData={structuredData}
>
  <CapabilitiesMarketOpportunityPage client:load />
</PresentationLayout>
