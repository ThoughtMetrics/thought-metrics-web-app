---
import PresentationLayout from '@/layouts/PresentationLayout.astro';
import CapabilitiesBrandingAdvertisingPage from '@/shared/screens/capabilities/branding-advertising/BrandingAdvertisingPage';
import { seoConfig } from '@/core/constants/seo.constants';
import { buildStandardPageSchema } from '@/core/utils/schema-builder';
import { generateBreadcrumbsFromPath } from '@/routes/routeConfig';

const seoContent = {
  title: 'Branding & Advertising Research | Campaign Effectiveness',
  description: 'Measure, analyze, and optimize advertising performance. From brand perception and awareness tracking to message testing and ROI—uncover what works and why.',
  keywords: 'advertising research, brand tracking, message testing, advertising effectiveness, market research, campaign optimization, brand perception, marketing analytics',
};

// Generate breadcrumbs and structured data for SEO
const breadcrumbs = generateBreadcrumbsFromPath(Astro.url.pathname);
const pageUrl = new URL(Astro.url.pathname, seoConfig.siteUrl).href;
const structuredData = buildStandardPageSchema(
  seoConfig,
  pageUrl,
  'Branding & Advertising Research',
  breadcrumbs
);
---

<PresentationLayout
  title={seoContent.title}
  description={seoContent.description}
  structuredData={structuredData}
>
  <CapabilitiesBrandingAdvertisingPage client:load />
</PresentationLayout>
