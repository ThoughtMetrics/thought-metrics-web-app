# ====================================
# Docker Ignore File
# ====================================
# Exclude files and directories from Docker build context
# This reduces build time and image size

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build output
dist/
.astro/

# Environment files (never copy to image for security)
.env
.env.*
!.env.example
!.env.docker

# Git
.git/
.gitignore
.gitattributes

# IDE and Editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Testing
coverage/
*.test.js
*.spec.js
.nyc_output/

# Documentation
README.md
CHANGELOG.md
LICENSE
*.md
!package.json

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml
.circleci/

# Docker files (no need to copy these into the image)
Dockerfile*
docker-compose*.yml
.dockerignore

# Logs
logs/
*.log

# Temporary files
tmp/
temp/
*.tmp

# OS files
Thumbs.db
.DS_Store

# Misc
.cache/
.temp/
