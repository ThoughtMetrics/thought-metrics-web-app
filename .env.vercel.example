# Vercel Environment Variables — copy these keys into your Vercel project settings
# (Settings → Environment Variables). Never commit actual values.
#
# PUBLIC_ prefix = exposed to browser via window.__APP_CONFIG__ (RuntimeConfig.astro)
# Non-prefixed = server-only, never sent to client

# ── Firebase ──────────────────────────────────────────────────────────────────
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=
PUBLIC_MEASUREMENT_ID=

# ── Backend API ───────────────────────────────────────────────────────────────
PUBLIC_BASE_URL=https://thoughtmetricswebapi.azurewebsites.net/api
PUBLIC_BASE_API_VERSION=/v1
PUBLIC_SITE_URL=https://www.thoughtmetrics.com
PUBLIC_STRAPI_API_URL=https://thoughtmetrics-strapi.azurewebsites.net/api
PUBLIC_QUEUE_URL=https://stagethoughtmetricssurveyqueue.azurewebsites.net

# ── Analytics & Tracking ─────────────────────────────────────────────────────
PUBLIC_GTM_ID=
PUBLIC_GOOGLE_SITE_VERIFICATION=

# ── Payments ──────────────────────────────────────────────────────────────────
PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=          # SERVER-ONLY — never prefix with PUBLIC_

# ── Cookie Consent ────────────────────────────────────────────────────────────
PUBLIC_COOKIEBOT_ID=

# ── Azure (server-only) ───────────────────────────────────────────────────────
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=

# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=production

# ── IMPORTANT: Firebase Authorized Domains ────────────────────────────────────
# After deploying, add your Vercel URL (e.g. your-project.vercel.app) to:
# Firebase Console → Authentication → Settings → Authorized Domains
# Otherwise Google/Email sign-in will be blocked.
