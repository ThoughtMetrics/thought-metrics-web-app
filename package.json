{
  "name": "thought-metrics-web-app",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev --host --port 4200",
    "build": "astro check && astro build",
    "preview": "astro preview --port 4200",
    "astro": "astro",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "astro check && tsc --noEmit",
    "serve": "npx serve dist -p 4200",
    "docker:build": "docker build -t thought-metrics-web-app:v1 .",
    "docker:run": "docker run -d -p 4200:4200 --name thought-metrics-web-app --env-file .env.docker thought-metrics-web-app:v1"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.7",
    "@astrojs/node": "^9.5.0",
    "@astrojs/partytown": "^2.1.4",
    "@astrojs/react": "^4.4.0",
    "@astrojs/sitemap": "^3.6.0",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-query": "^5.90.5",
    "@tanstack/react-query-devtools": "^5.90.2",
    "@types/leaflet": "^1.9.21",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "astro": "^5.14.4",
    "astro-icon": "^1.1.5",
    "axios": "^1.12.2",
    "clsx": "^2.1.1",
    "firebase": "^12.6.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.555.0",
    "qs": "^6.14.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-leaflet": "^4.2.1",
    "recharts": "^3.8.0",
    "sonner": "^2.0.7",
    "swiper": "^12.0.2",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.14",
    "vite-plugin-svgr": "^4.5.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@eslint/js": "^9.37.0",
    "@types/node": "^24.8.1",
    "@types/qs": "^6.14.0",
    "@typescript-eslint/eslint-plugin": "^8.46.1",
    "@typescript-eslint/parser": "^8.46.1",
    "baseline-browser-mapping": "^2.10.0",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.3.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.0",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "serve": "^14.2.5",
    "typescript": "^5.9.3"
  }
}
