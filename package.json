{
  "name": "thought-metrics-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host --port 4200",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run --reporter=verbose",
    "build:ssg": "npm run build && node scripts/prerender.mjs",
    "serve": "npx serve dist -p 4200",
    "docker:build": "docker build -t thought-metrics-web-app:v1 .",
    "docker:run": "docker run -d -p 4200:4200 --name thought-metrics-web-app --env-file .env.docker thought-metrics-web-app:v1"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.85.5",
    "axios": "^1.11.0",
    "clsx": "^2.1.1",
    "firebase": "^11.2.0",
    "qs": "^6.14.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sonner": "^2.0.7",
    "swiper": "^11.2.10",
    "tailwind-merge": "^3.3.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@tailwindcss/vite": "^4.1.11",
    "@tanstack/react-query-devtools": "^5.85.5",
    "@types/node": "^24.0.14",
    "@types/qs": "^6.14.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@typescript-eslint/eslint-plugin": "^8.37.0",
    "@typescript-eslint/parser": "^8.37.0",
    "@vitejs/plugin-react-swc": "^3.10.2",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.30.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "puppeteer": "^24.17.0",
    "react-router-dom": "^7.7.0",
    "sass": "^1.89.2",
    "serve": "^14.2.4",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^7.0.4",
    "vite-plugin-svgr": "^4.3.0",
    "vitest": "^3.2.4"
  }
}